{
  "schemaVersion": 2,
  "definitions": {
    "ProjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "displayName",
        "active",
        "available"
      ]
    },
    "ProjectEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink",
            "other"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "relativePath",
        "kind",
        "size"
      ]
    },
    "DirectoryListing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativeDir": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectEntry"
          },
          "maxItems": 400
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "relativeDir",
        "entries",
        "truncated"
      ]
    },
    "TextPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 524288
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "projectId",
        "relativePath",
        "text",
        "byteLength",
        "revision"
      ]
    },
    "SourceLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineNumber": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        },
        "newline": {
          "type": "string",
          "enum": [
            "lf",
            "crlf",
            "none"
          ]
        }
      },
      "required": [
        "lineNumber",
        "text",
        "startByte",
        "endByte",
        "newline"
      ]
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "firstLine": {
          "type": "integer",
          "minimum": 1
        },
        "lastLine": {
          "type": "integer",
          "minimum": 1
        },
        "totalLines": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceLine"
          },
          "maxItems": 120
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "relativePath",
        "revision",
        "firstLine",
        "lastLine",
        "totalLines",
        "lines"
      ]
    },
    "ReviewLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "context",
            "added",
            "removed"
          ]
        },
        "text": {
          "type": "string"
        },
        "oldLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "newLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "text",
        "oldLine",
        "newLine"
      ]
    },
    "ReviewHunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string"
        },
        "oldStart": {
          "type": "integer",
          "minimum": 0
        },
        "oldLines": {
          "type": "integer",
          "minimum": 0
        },
        "newStart": {
          "type": "integer",
          "minimum": 0
        },
        "newLines": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewLine"
          }
        }
      },
      "required": [
        "header",
        "oldStart",
        "oldLines",
        "newStart",
        "newLines",
        "lines"
      ]
    },
    "ChangeReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unchanged": {
          "type": "boolean"
        },
        "removedLines": {
          "type": "integer",
          "minimum": 0
        },
        "addedLines": {
          "type": "integer",
          "minimum": 0
        },
        "countsExact": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "hunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewHunk"
          },
          "maxItems": 64
        }
      },
      "required": [
        "projectId",
        "relativePath",
        "expectedRevision",
        "proposedRevision",
        "unchanged",
        "removedLines",
        "addedLines",
        "countsExact",
        "truncated",
        "hunks"
      ]
    },
    "ProposalSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inboxId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "claimedProducer": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "editCount": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved_for_staging",
            "rejected"
          ]
        }
      },
      "required": [
        "inboxId",
        "taskId",
        "projectId",
        "claimedProducer",
        "rationale",
        "editCount",
        "digest",
        "status"
      ]
    },
    "ProposalDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/ProposalSummary"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeReview"
          }
        }
      },
      "required": [
        "summary",
        "reviews"
      ]
    },
    "StagingEdit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposedText": {
          "type": "string"
        }
      },
      "required": [
        "relativePath",
        "expectedRevision",
        "proposedText"
      ]
    },
    "ApprovedStaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/ProposalSummary"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StagingEdit"
          }
        }
      },
      "required": [
        "summary",
        "edits"
      ]
    }
  },
  "operations": {
    "project.list": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProjectSummary"
        }
      }
    },
    "project.select": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProjectSummary"
        }
      }
    },
    "project.open": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "projectId"
        ]
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProjectSummary"
        }
      }
    },
    "project.close": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "projectId"
        ]
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProjectSummary"
        }
      }
    },
    "project.unregister": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "projectId"
        ]
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProjectSummary"
        }
      }
    },
    "source.list": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "relativeDir": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "projectId",
          "relativeDir"
        ]
      },
      "result": {
        "$ref": "#/$defs/DirectoryListing"
      }
    },
    "source.preview": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "projectId",
          "relativePath"
        ]
      },
      "result": {
        "$ref": "#/$defs/TextPreview"
      }
    },
    "source.readSpan": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "firstLine": {
            "type": "integer",
            "minimum": 1
          },
          "lastLine": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "projectId",
          "relativePath",
          "expectedRevision",
          "firstLine",
          "lastLine"
        ]
      },
      "result": {
        "$ref": "#/$defs/SourceSpan"
      }
    },
    "source.review": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposedText": {
            "type": "string",
            "maxLength": 524288
          }
        },
        "required": [
          "projectId",
          "relativePath",
          "expectedRevision",
          "proposedText"
        ]
      },
      "result": {
        "$ref": "#/$defs/ChangeReview"
      }
    },
    "source.save": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 524288
          }
        },
        "required": [
          "projectId",
          "relativePath",
          "expectedRevision",
          "text"
        ]
      },
      "result": {
        "$ref": "#/$defs/TextPreview"
      }
    },
    "proposal.import": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "proposalJson": {
            "type": "string",
            "maxLength": 650000
          }
        },
        "required": [
          "proposalJson"
        ]
      },
      "result": {
        "$ref": "#/$defs/ProposalSummary"
      }
    },
    "proposal.list": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProposalSummary"
        }
      }
    },
    "proposal.review": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inboxId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "inboxId"
        ]
      },
      "result": {
        "$ref": "#/$defs/ProposalDetail"
      }
    },
    "proposal.decide": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inboxId": {
            "type": "string",
            "minLength": 1
          },
          "expectedDigest": {
            "type": "string",
            "minLength": 1
          },
          "approveForStaging": {
            "type": "boolean"
          }
        },
        "required": [
          "inboxId",
          "expectedDigest",
          "approveForStaging"
        ]
      },
      "result": {
        "$ref": "#/$defs/ProposalSummary"
      }
    },
    "proposal.stage": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inboxId": {
            "type": "string",
            "minLength": 1
          },
          "expectedDigest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "inboxId",
          "expectedDigest"
        ]
      },
      "result": {
        "$ref": "#/$defs/ApprovedStaging"
      }
    },
    "proposal.discard": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inboxId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "inboxId"
        ]
      },
      "result": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/ProposalSummary"
        }
      }
    }
  }
}
