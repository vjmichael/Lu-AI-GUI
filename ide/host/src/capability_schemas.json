{
  "schemaVersion": 2,
  "definitions": {
    "ProjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "displayName",
        "active",
        "available"
      ]
    },
    "ProjectEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "symlink",
            "other"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "relativePath",
        "kind",
        "size"
      ]
    },
    "DirectoryListing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativeDir": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectEntry"
          },
          "maxItems": 400
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "relativeDir",
        "entries",
        "truncated"
      ]
    },
    "TextPreview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 524288
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "projectId",
        "relativePath",
        "text",
        "byteLength",
        "revision"
      ]
    },
    "SourceLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineNumber": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        },
        "newline": {
          "type": "string",
          "enum": [
            "lf",
            "crlf",
            "none"
          ]
        }
      },
      "required": [
        "lineNumber",
        "text",
        "startByte",
        "endByte",
        "newline"
      ]
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "firstLine": {
          "type": "integer",
          "minimum": 1
        },
        "lastLine": {
          "type": "integer",
          "minimum": 1
        },
        "totalLines": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceLine"
          },
          "maxItems": 120
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "relativePath",
        "revision",
        "firstLine",
        "lastLine",
        "totalLines",
        "lines"
      ]
    },
    "ReviewLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "context",
            "added",
            "removed"
          ]
        },
        "text": {
          "type": "string"
        },
        "oldLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "newLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "text",
        "oldLine",
        "newLine"
      ]
    },
    "ReviewHunk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string"
        },
        "oldStart": {
          "type": "integer",
          "minimum": 0
        },
        "oldLines": {
          "type": "integer",
          "minimum": 0
        },
        "newStart": {
          "type": "integer",
          "minimum": 0
        },
        "newLines": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewLine"
          }
        }
      },
      "required": [
        "header",
        "oldStart",
        "oldLines",
        "newStart",
        "newLines",
        "lines"
      ]
    },
    "ChangeReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "unchanged": {
          "type": "boolean"
        },
        "removedLines": {
          "type": "integer",
          "minimum": 0
        },
        "addedLines": {
          "type": "integer",
          "minimum": 0
        },
        "countsExact": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "hunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewHunk"
          },
          "maxItems": 64
        }
      },
      "required": [
        "projectId",
        "relativePath",
        "expectedRevision",
        "proposedRevision",
        "unchanged",
        "removedLines",
        "addedLines",
        "countsExact",
        "truncated",
        "hunks"
      ]
    },
    "ProposalSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inboxId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "claimedProducer": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "editCount": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved_for_staging",
            "rejected"
          ]
        }
      },
      "required": [
        "inboxId",
        "taskId",
        "projectId",
        "claimedProducer",
        "rationale",
        "editCount",
        "digest",
        "status"
      ]
    },
    "ProposalDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/ProposalSummary"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeReview"
          }
        }
      },
      "required": [
        "summary",
        "reviews"
      ]
    },
    "StagingEdit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposedText": {
          "type": "string"
        }
      },
      "required": [
        "relativePath",
        "expectedRevision",
        "proposedText"
      ]
    },
    "ApprovedStaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/ProposalSummary"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StagingEdit"
          }
        }
      },
      "required": [
        "summary",
        "edits"
      ]
    },
    "DevelopmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "eventId": {
          "type": "string"
        },
        "observedUnixSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "projectId": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "enum": [
            "project.register",
            "project.open",
            "project.close",
            "project.unregister",
            "source.save"
          ]
        },
        "outcome": {
          "type": "string",
          "const": "observed_host_success"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "sourcePath": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "observedUnixSeconds",
        "projectId",
        "operation",
        "outcome",
        "sourceRevision",
        "summary",
        "sourcePath"
      ]
    },
    "ContextDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "present_unverified",
            "missing",
            "unverifiable"
          ]
        },
        "trust": {
          "type": "string",
          "const": "untrusted_project_text"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "byteLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerptTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "relativePath",
        "availability",
        "trust",
        "sourceRevision",
        "byteLength",
        "excerpt",
        "excerptTruncated"
      ]
    },
    "ProjectContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "projectId": {
          "type": "string"
        },
        "projectName": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "const": "local_standalone_host"
        },
        "remoteGitState": {
          "type": "string",
          "const": "not_queried"
        },
        "localArtifacts": {
          "type": "string",
          "const": "bounded_scan"
        },
        "currentToolchainReadiness": {
          "type": "string",
          "const": "not_verified"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DevelopmentEvent"
          },
          "maxItems": 40
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextDocument"
          },
          "maxItems": 12
        },
        "inventory": {
          "$ref": "#/$defs/EvidenceInventory"
        },
        "gitWorktree": {
          "$ref": "#/$defs/GitWorktreeInspection"
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "projectName",
        "source",
        "remoteGitState",
        "localArtifacts",
        "currentToolchainReadiness",
        "events",
        "documents",
        "inventory",
        "gitWorktree"
      ]
    },
    "EvidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "const": "present_unverified"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "digestStatus": {
          "type": "string"
        },
        "trust": {
          "type": "string",
          "const": "untrusted_project_file"
        }
      },
      "required": [
        "relativePath",
        "category",
        "state",
        "sizeBytes",
        "sha256",
        "digestStatus",
        "trust"
      ]
    },
    "GitObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "localHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "localTrackingHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trackingComparison": {
          "type": "string"
        },
        "workingTree": {
          "type": "string"
        },
        "liveRemote": {
          "type": "string",
          "const": "not_queried"
        }
      },
      "required": [
        "state",
        "branch",
        "localHead",
        "localTrackingHead",
        "trackingComparison",
        "workingTree",
        "liveRemote"
      ]
    },
    "EvidenceInventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "projectId": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "discoveryComplete": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceFile"
          },
          "maxItems": 80
        },
        "git": {
          "$ref": "#/$defs/GitObservation"
        },
        "toolchainReadiness": {
          "type": "string",
          "enum": [
            "not_verified",
            "present_unverified"
          ]
        },
        "executionPerformed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "scope",
        "discoveryComplete",
        "files",
        "git",
        "toolchainReadiness",
        "executionPerformed"
      ]
    },
    "StoredArtifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "digestStatus": {
          "type": "string"
        }
      },
      "required": [
        "relativePath",
        "sizeBytes",
        "sha256",
        "digestStatus"
      ]
    },
    "InventoryBaseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": "string"
        },
        "observedUnixSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoredArtifact"
          },
          "maxItems": 80
        },
        "localHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "localTrackingHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gitWorktreeState": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "clean",
                "dirty"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectId",
        "observedUnixSeconds",
        "scope",
        "artifacts",
        "localHead",
        "localTrackingHead",
        "gitWorktreeState"
      ]
    },
    "ArtifactComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "baselineSha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentSha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "matched_bytes",
            "changed_bytes",
            "changed_size_only",
            "missing_in_scanned_scope",
            "unverifiable",
            "present_unverifiable",
            "new_in_scanned_scope"
          ]
        }
      },
      "required": [
        "relativePath",
        "baselineSha256",
        "currentSha256",
        "status"
      ]
    },
    "InventoryComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "projectId": {
          "type": "string"
        },
        "baselinePresent": {
          "type": "boolean"
        },
        "baselineUnixSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "discoveryComplete": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactComparison"
          },
          "maxItems": 160
        },
        "localGitHeadChange": {
          "type": "string"
        },
        "liveRemote": {
          "type": "string",
          "const": "not_queried"
        },
        "baselineCount": {
          "type": "integer",
          "minimum": 0
        },
        "gitWorktreeChange": {
          "type": "string",
          "enum": [
            "baseline_missing",
            "remained_clean",
            "became_dirty",
            "became_clean",
            "both_dirty_not_equivalent",
            "unverifiable"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "baselinePresent",
        "baselineUnixSeconds",
        "discoveryComplete",
        "entries",
        "localGitHeadChange",
        "liveRemote",
        "baselineCount",
        "gitWorktreeChange"
      ]
    },
    "GitFileChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "relativePath",
        "kind",
        "stage"
      ]
    },
    "GitWorktreeInspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "localHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstreamHead": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "upstreamComparison": {
          "type": "string"
        },
        "commitsAhead": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "commitsBehind": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree": {
          "type": "string"
        },
        "modifiedOrStagedCount": {
          "type": "integer",
          "minimum": 0
        },
        "untrackedCount": {
          "type": "integer",
          "minimum": 0
        },
        "displayedChanges": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/GitFileChange"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "liveRemote": {
          "type": "string",
          "const": "not_queried"
        }
      },
      "required": [
        "state",
        "branch",
        "localHead",
        "upstreamHead",
        "upstreamComparison",
        "commitsAhead",
        "commitsBehind",
        "worktree",
        "modifiedOrStagedCount",
        "untrackedCount",
        "displayedChanges",
        "truncated",
        "liveRemote"
      ]
    },
    "LiveGitHubComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "state": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "const": "github_public_rest_explicit_check"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedUnixSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
