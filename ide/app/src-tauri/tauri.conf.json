{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lu IDE",
  "version": "0.1.0-alpha.1",
  "identifier": "org.lu.ide",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lu IDE — Standalone Alpha",
        "width": 1240,
        "height": 820,
        "minWidth": 820,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
